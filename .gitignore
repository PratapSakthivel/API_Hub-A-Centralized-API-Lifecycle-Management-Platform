# Root .gitignore for API Hub Monorepo

# Environment variables & secrets
.env
.env.local
.env.*.local
*.env
!*.env.example

# OS / Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Backend / Java / Maven
backend/target/
backend/.flattened-pom.xml
backend/*.log
backend/.mvn/wrapper/maven-wrapper.jar

# Frontend / Node
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/coverage/

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
